{
  "websocket": {
    "apiId": "TU-API-ID-AQUI",
    "region": "us-east-1",
    "stage": "prod",
    "url": "wss://TU-API-ID-AQUI.execute-api.us-east-1.amazonaws.com/prod"
  },
  "dynamodb": {
    "region": "us-east-1",
    "tables": {
      "connections": "TillUpConnections",
      "userData": "TillUpUserData"
    }
  },
  "lambda": {
    "functions": {
      "connect": {
        "name": "TillUpWebSocketConnect",
        "handler": "index.handler",
        "runtime": "python3.12"
      },
      "disconnect": {
        "name": "TillUpWebSocketDisconnect", 
        "handler": "disconnect.lambda_handler",
        "runtime": "python3.12"
      },
      "message": {
        "name": "TillUpWebSocketMessage",
        "handler": "lambda_function.lambda_handler", 
        "runtime": "python3.12"
      }
    }
  },
  "iam": {
    "roleName": "TillUpWebSocketRole",
    "policies": [
      "AWSLambdaBasicExecutionRole",
      "DynamoDBFullAccess",
      "AmazonAPIGatewayInvokeFullAccess"
    ]
  },
  "security": {
    "token": "tillup_test",
    "maxConnectionsPerUser": 5,
    "rateLimiting": {
      "messagesPerMinute": 100,
      "burstLimit": 20
    }
  },
  "monitoring": {
    "cloudWatch": {
      "logGroups": [
        "/aws/lambda/TillUpWebSocketConnect",
        "/aws/lambda/TillUpWebSocketDisconnect", 
        "/aws/lambda/TillUpWebSocketMessage"
      ],
      "metrics": [
        "ConnectionCount",
        "MessageCount", 
        "ErrorCount",
        "Latency"
      ]
    }
  }
}